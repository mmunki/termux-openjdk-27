--- a/src/hotspot/os/posix/os_posix.cpp
+++ b/src/hotspot/os/posix/os_posix.cpp
@@ -1116,6 +1116,34 @@
   return is_same;
 }
 
+#ifdef __ANDROID__
+// Android does not always give the full path of the shared library in
+// dladdr().  When that happens the path is looked up in /proc/self/maps.
+static bool read_so_path_from_maps(const char* so_name, char* buf, int buflen) {
+  FILE *fp = fopen("/proc/self/maps", "r");
+  assert(fp, "Failed to open /proc/self/maps");
+  if (!fp) {
+    return false;
+  }
+
+  char maps_buffer[2048];
+  while (fgets(maps_buffer, 2048, fp) != NULL) {
+    if (strstr(maps_buffer, so_name) == NULL) {
+      continue;
+    }
+
+    char *so_path = strchr(maps_buffer, '/');
+    so_path[strlen(so_path) - 1] = '\0'; // Cut trailing \n
+    jio_snprintf(buf, buflen, "%s", so_path);
+    fclose(fp);
+    return true;
+  }
+
+  fclose(fp);
+  return false;
+}
+#endif
+
 static char saved_jvm_path[MAXPATHLEN] = {0};
 
 // Find the full path to the current module, libjvm.so
@@ -1153,6 +1181,19 @@
   }
   fname = dli_fname;
 #endif // AIX
+#ifdef __ANDROID__
+  if (fname[0] == '\0') {
+    return;
+  }
+
+  if (strchr(fname, '/') == NULL) {
+    bool ok = read_so_path_from_maps(fname, buf, buflen);
+    assert(ok, "unable to turn relative libjvm.so path into absolute");
+    return;
+  }
+
+  snprintf(buf, buflen, "%s", fname);
+#else // !__ANDROID__
   char* rp = nullptr;
   if (fname[0] != '\0') {
     rp = os::realpath(fname, buf, buflen);
@@ -1203,6 +1244,7 @@
 
   strncpy(saved_jvm_path, buf, MAXPATHLEN);
   saved_jvm_path[MAXPATHLEN - 1] = '\0';
+#endif // !__ANDROID__
 }
 
 // Called when creating the thread.  The minimum stack sizes have already been calculated
--- a/make/common/JdkNativeCompilation.gmk
+++ b/make/common/JdkNativeCompilation.gmk
@@ -49,8 +49,10 @@
     SetSharedLibraryOrigin =
   else
     ifeq ($(call isTargetOs, linux), true)
+      # Do not disable new dtags: Termux wants DT_RUNPATH instead of DT_RPATH
+      # so that LD_LIBRARY_PATH keeps working for the user.
       SetExecutableOrigin = \
-          -Wl,-rpath,\$(DOLLAR)ORIGIN$1 -Wl,--disable-new-dtags
+          -Wl,-rpath,\$(DOLLAR)ORIGIN$1
     else
       SetExecutableOrigin = \
           -Wl,-rpath,\$(DOLLAR)ORIGIN$1
